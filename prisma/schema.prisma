generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Store {
  id                  String               @id @default(uuid())
  name                String
  userId              String
  logoUrl             String?
  faviconUrl          String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  billboards          Billboard[]          @relation("StoreToBillboard")
  homepageBillboardId String?
  homepageBillboard   Billboard?           @relation("StoreHomepageBillboard", fields: [homepageBillboardId], references: [id])
  categories          Category[]           @relation("StoreToCategory")
  colors              Color[]              @relation("StoreToColor")
  orders              Order[]              @relation("StoreToOrder")
  products            Product[]            @relation("StoreToProduct")
  sizes               Size[]               @relation("StoreToSize")
  billingProfile      StoreBillingProfile?

  // Per-Store email kill switch. When true, no Storvia-generated email for this
  // Store is sent (new-order notifications, invoice emails). Private: never
  // returned by public Storefront APIs.
  emailDeliveryBlocked Boolean @default(false)

  // Merchant-editable WhatsApp message templates (Roman Urdu defaults live in
  // lib/whatsapp-message.ts). null = use the default. Private: never returned by
  // public Storefront APIs.
  whatsappConfirmTemplate String?
  whatsappMessageTemplate String?

  // Sender (return address) printed on packing slips. Edited in Settings; the
  // merchant route requires all four together. Private: never returned by
  // public Storefront APIs.
  senderName    String?
  senderPhone   String?
  senderAddress String?
  senderCity    String?

  // Current Billing Plan assignment (Release 1: no history/effective-dating).
  billingPlanId String?
  billingPlan   BillingPlan? @relation("StoreCurrentBillingPlan", fields: [billingPlanId], references: [id], onDelete: Restrict)
  invoices      Invoice[]    @relation("StoreToInvoice")

  @@index([homepageBillboardId])
  @@index([billingPlanId])
}

model StoreBillingProfile {
  id                        String   @id @default(uuid())
  storeId                   String   @unique
  legalName                 String?
  billingContactName        String?
  billingEmail              String?
  billingPhone              String?
  addressLine1              String?
  addressLine2              String?
  city                      String?
  postalCode                String?
  country                   String?
  taxNumber                 String?
  companyRegistrationNumber String?
  currency                  String   @default("PKR")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  store                     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

enum BillingPlanType {
  FIXED
  PERCENTAGE
}

model BillingPlan {
  id             String          @id @default(uuid())
  name           String
  type           BillingPlanType
  // Exactly one of these is populated per `type`; enforced by the future
  // Billing Plan API/service layer, not by this schema.
  fixedAmount    Decimal?
  percentageRate Decimal?
  // Soft-retire only: an archived plan is no longer assignable to new
  // Stores but remains physically present for Stores/Invoices that
  // reference it (see onDelete: Restrict below).
  isArchived     Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  stores   Store[]   @relation("StoreCurrentBillingPlan")
  invoices Invoice[] @relation("InvoiceBillingPlan")
}

enum InvoicePaymentStatus {
  PENDING
  PAID
}

enum InvoiceEmailStatus {
  NOT_SENT
  SENT
  FAILED
}

model Invoice {
  id            String @id @default(uuid())
  invoiceNumber String @unique

  storeId String
  store   Store  @relation("StoreToInvoice", fields: [storeId], references: [id], onDelete: Restrict)

  // Billing month, stored as separate integers (never a display string or
  // a DateTime) so Store + month uniqueness is a plain composite key.
  billingMonthYear  Int
  billingMonthMonth Int

  // Historical reference only — traceability, never re-read to recompute
  // an already-generated invoice's calculation.
  billingPlanId String
  billingPlan   BillingPlan @relation("InvoiceBillingPlan", fields: [billingPlanId], references: [id], onDelete: Restrict)

  // Immutable calculation snapshot — the sole source of truth for this
  // invoice's historical figures, independent of the live BillingPlan row.
  billingPlanName String
  billingPlanType BillingPlanType

  fixedAmount    Decimal?
  percentageRate Decimal?

  eligibleSales    Decimal
  basePlatformFee  Decimal
  additionalCharge Decimal @default(0)
  discount         Decimal @default(0)
  total            Decimal

  currency String  @default("PKR")
  notes    String?

  invoiceDate DateTime @default(now())
  dueDate     DateTime @default(now())

  paymentStatus InvoicePaymentStatus @default(PENDING)

  emailStatus        InvoiceEmailStatus @default(NOT_SENT)
  emailSentAt        DateTime?
  lastEmailAttemptAt DateTime?
  emailError         String?
  emailAttemptCount  Int                @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment?

  @@unique([storeId, billingMonthYear, billingMonthMonth])
  @@index([storeId])
  @@index([billingPlanId])
  @@index([paymentStatus])
}

model Payment {
  id        String  @id @default(uuid())
  invoiceId String  @unique
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  // Release 1 is full-payment only; amount is expected to equal
  // Invoice.total at the service layer.
  amount      Decimal
  paymentDate DateTime
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidence PaymentEvidence[]
}

model PaymentEvidence {
  id        String  @id @default(uuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  url       String
  publicId  String?
  fileName  String
  mimeType  String
  sizeBytes Int?

  createdAt DateTime @default(now())

  @@index([paymentId])
}

model Billboard {
  id                String           @id @default(uuid())
  storeId           String
  label             String
  // Cover photo; always equal to the first BillboardImage.
  imageUrl          String
  // Homepage-only presentation (category pages show imageUrl + label).
  layout            BillboardLayout  @default(SPLIT)
  subheading        String?
  showSearch        Boolean          @default(true)
  // Optional button: both set or both null. Links to a Category of this Store.
  ctaLabel          String?
  ctaCategoryId     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  store             Store            @relation("StoreToBillboard", fields: [storeId], references: [id])
  homepageForStores Store[]          @relation("StoreHomepageBillboard")
  categories        Category[]       @relation("CategoryBillboard")
  ctaCategory       Category?        @relation("BillboardCtaCategory", fields: [ctaCategoryId], references: [id], onDelete: SetNull)
  images            BillboardImage[]

  @@index([storeId])
  @@index([ctaCategoryId])
}

model BillboardImage {
  id          String    @id @default(uuid())
  billboardId String
  url         String
  // Merchant-chosen order (0 = cover); ties break by createdAt.
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  billboard   Billboard @relation(fields: [billboardId], references: [id], onDelete: Cascade)

  @@index([billboardId])
}

enum BillboardLayout {
  SPLIT
  FULL_BLEED
  HEADING_LED
}

model Category {
  id            String      @id @default(uuid())
  storeId       String
  billboardId   String?
  parentId      String?
  name          String
  // Curated icon key from lib/category-icons.ts (null = no icon).
  iconKey       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  billboard     Billboard?  @relation("CategoryBillboard", fields: [billboardId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  store         Store       @relation("StoreToCategory", fields: [storeId], references: [id])
  parent        Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children      Category[]  @relation("CategoryHierarchy")
  products      Product[]   @relation("CategoryToProduct")
  ctaBillboards Billboard[] @relation("BillboardCtaCategory")

  @@index([storeId])
  @@index([billboardId])
  @@index([parentId])
}

model Product {
  id             String      @id @default(uuid())
  storeId        String
  categoryId     String
  name           String
  price          Decimal
  // Display-only "was" price for sales; never used by orders, totals, billing or metrics.
  compareAtPrice Decimal?
  quantity       Int         @default(0)
  isFeatured     Boolean     @default(false)
  isArchived     Boolean     @default(false)
  sizeId         String
  colorId        String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  images         Image[]
  orderItems     OrderItem[]
  category       Category    @relation("CategoryToProduct", fields: [categoryId], references: [id])
  color          Color       @relation(fields: [colorId], references: [id])
  size           Size        @relation(fields: [sizeId], references: [id])
  store          Store       @relation("StoreToProduct", fields: [storeId], references: [id])

  @@index([storeId])
  @@index([categoryId])
  @@index([sizeId])
  @@index([colorId])
}

model Order {
  id         String      @id @default(uuid())
  storeId    String
  store      Store       @relation("StoreToOrder", fields: [storeId], references: [id])
  orderItems OrderItem[]

  status        OrderStatus   @default(DRAFT)
  paymentMethod PaymentMethod @default(COD)
  trackingId    String        @unique

  // Nullable for legacy orders created before immutable snapshots existed.
  subtotal Decimal?
  total    Decimal?
  currency String?

  // payment flags
  isPaid Boolean @default(false)

  // Latest CONFIRMED transition timestamp (DRAFT->CONFIRMED or CANCELED->CONFIRMED).
  // Authoritative for billing-month attribution. Null on legacy rows and on
  // orders that have never been confirmed; never backfilled from createdAt.
  confirmedAt DateTime?

  // customer
  customerName String @default("")
  email        String @default("")
  phone        String @default("")

  // shipping (structured)
  addressLine1 String @default("")
  addressLine2 String @default("")
  city         String @default("")
  postalCode   String @default("")
  country      String @default("PK")

  // notes
  customerNotes String @default("")

  // legacy field (keep for backwards compatibility)
  // You can remove this later after you migrate UI fully.
  address String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([trackingId])
  @@index([status])
  @@index([paymentMethod])
  @@index([isPaid])
  @@index([city])
  @@index([confirmedAt])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  quantity  Int      @default(1)
  // Captured from Product.price at order creation; null on legacy rows.
  unitPrice Decimal?
  lineTotal Decimal?
  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Size {
  id        String    @id @default(uuid())
  storeId   String
  name      String
  value     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
  store     Store     @relation("StoreToSize", fields: [storeId], references: [id])

  @@index([storeId])
}

model Color {
  id        String    @id @default(uuid())
  storeId   String
  name      String
  value     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  store     Store     @relation("StoreToColor", fields: [storeId], references: [id])
  products  Product[]

  @@index([storeId])
}

model Image {
  id        String   @id @default(uuid())
  productId String
  url       String
  // Merchant-chosen order (0 = cover). Legacy rows are all 0; ties break by createdAt.
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  DELIVERED
  CANCELED
}

enum PaymentMethod {
  STRIPE
  COD
}

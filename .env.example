# Clerk (read by the Clerk SDK and middleware)
# Publishable and secret key of the Clerk application.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Sign-in and sign-up routes, and where to land afterwards.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Super Admin
# Clerk user id of the single designated Super Admin.
# Leave empty to disable all /api/super-admin/* access (fails closed).
SUPER_ADMIN_CLERK_USER_ID=

# PostgreSQL / Prisma
# Pooled connection string used by the app.
DATABASE_URL=
# Direct (unpooled) connection string used by Prisma migrations.
DATABASE_URL_UNPOOLED=

# Cloudinary (read by next-cloudinary for image uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Resend (email)
# API key; without it no email is sent.
RESEND_API_KEY=
# From address for new-order and invoice emails, e.g. "Store Orders <orders@your-domain>".
RESEND_FROM_EMAIL=
# Optional: send every email to this address instead of the real recipient (testing).
RESEND_TEST_RECIPIENT=

# Demo seed (dev only; npm run seed:demo)
# Must be "true" for the seed script to reset a Store's catalog.
ALLOW_DEMO_DATA_RESET=
# Id of the Store whose catalog the seed script resets.
DEMO_STORE_ID=
